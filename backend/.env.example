# Copy this file to .env and replace every placeholder with your LOCAL values.
# Never commit .env.

DB_URL=jdbc:mysql://localhost:3306/bookstore
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_FULL_NAME=BookNest Administrator

MAIL_USERNAME=your_gmail_address
MAIL_APP_PASSWORD=your_gmail_app_password

RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

RAZORPAY_CALLBACK_BASE_URL=http://localhost:8080/api/payments/callback
APP_FRONTEND_URL=http://localhost:5173
